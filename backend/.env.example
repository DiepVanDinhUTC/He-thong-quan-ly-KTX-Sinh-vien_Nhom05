# .env.example
PORT=5000
# VNPAY sandbox defaults; replace terminal and secret with merchant credentials.
VNPAY_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
VNPAY_TMN_CODE=
VNPAY_HASH_SECRET=
# Leave as VNPAYQR to open QR directly; set to an empty value to let VNPAY show supported methods.
VNPAY_BANK_CODE=VNPAYQR
# Browser return endpoint; VNPAY appends transaction result parameters.
VNPAY_RETURN_URL=http://localhost:5173/bill-payment
# Supabase Dashboard > Connect > Session pooler (use port 5432).
# URL-encode reserved characters in the password.
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@<pooler-host>:5432/postgres?sslmode=require
JWT_SECRET=replace_with_a_long_random_secret
JWT_EXPIRES_IN=1d
# Vai trò giả lập bị khóa trên production; chỉ bật khi môi trường đó dùng dữ liệu kiểm thử.
ALLOW_ADMIN_ROLE_TESTING=false
# SIS source shared by regular-student sync and military GDQP sync.
# Keep the mock URL for demo; replace it with the school's endpoint when available.
SIS_UTC_API_URL=http://localhost:5000/api/v1/mock/sis-utc/students
SIS_API_TOKEN=
SIS_API_TIMEOUT_MS=15000
SIS_STUDENT_DEFAULT_PASSWORD=Ktx@2026
# GDQP reuses SIS_UTC_API_URL; each matching SIS student record must include its course registrations.
SIS_GDQP_ENABLED=false
SIS_GDQP_COURSE_CODE=GDQP101
SIS_GDQP_BATCHES=DOT-1,DOT-2
SIS_GDQP_FACULTY_CODES=KHOA-CNTT,KHOA-CT,KHOA-VTK,KHOA-DT,KHOA-CK
SIS_MILITARY_STUDENT_DEFAULT_PASSWORD=
SIS_GDQP_CRON=15 2 * * *
SIS_GDQP_TIMEZONE=Asia/Ho_Chi_Minh
TICKET_SLA_CRON=*/5 * * * *
TICKET_SLA_TIMEZONE=Asia/Ho_Chi_Minh
RESEND_API_KEY=
MAIL_FROM=
# Chỉ bật khi phát triển trên máy cá nhân; API sẽ trả mã xác minh trong phản hồi.
ENABLE_DEBUG_RESET_CODES=false
